<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Create a new post on Quora CRUD — Share your thoughts with the community.">
    <title>Create Post — Quora</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <header class="site-header">
        <div class="header-inner">
            <a href="/posts" class="site-logo">Q<span>uora</span></a>
        </div>
    </header>

    <main>
        <div class="page-container">
            <a href="/posts" class="back-link" id="back-to-posts">&#8592; Back to Posts</a>

            <div class="form-card">
                <h1 class="page-title">Create a Post</h1>
                <p class="page-subtitle">Share your thoughts with the community</p>

                <!-- Error banner -->
                <% if(error) { %>
                    <div class="alert alert-error" id="form-error" role="alert">
                        <span class="alert-icon">⚠️</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form action="/posts" method="post" id="create-post-form" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="username">
                            Username
                            <span class="char-counter" id="username-counter">0 / 50</span>
                        </label>
                        <input
                            class="form-input"
                            id="username"
                            type="text"
                            placeholder="Enter your username"
                            name="username"
                            maxlength="50"
                            autocomplete="off"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="content">
                            Your Post
                            <span class="char-counter" id="content-counter">0 / 500</span>
                        </label>
                        <textarea
                            class="form-textarea"
                            id="content"
                            placeholder="What's on your mind?"
                            name="content"
                            maxlength="500"
                            required
                        ></textarea>
                    </div>

                    <div class="form-actions">
                        <button class="btn btn-primary" type="submit" id="submit-post-btn">Publish Post</button>
                        <a href="/posts" class="btn btn-outline" id="cancel-create-btn">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <p>Quora CRUD &copy; <%= new Date().getFullYear() %> &nbsp;·&nbsp; Built with Node.js, Express &amp; EJS</p>
    </footer>

    <script>
        // Character counter helper
        function setupCounter(inputId, counterId, max) {
            const input = document.getElementById(inputId);
            const counter = document.getElementById(counterId);
            if (!input || !counter) return;

            const update = () => {
                const len = input.value.length;
                counter.textContent = `${len} / ${max}`;
                counter.className = 'char-counter';
                if (len >= max * 0.9) counter.classList.add('danger');
                else if (len >= max * 0.7) counter.classList.add('warn');
            };
            input.addEventListener('input', update);
            update();
        }

        setupCounter('username', 'username-counter', 50);
        setupCounter('content', 'content-counter', 500);

        // Client-side validation
        document.getElementById('create-post-form').addEventListener('submit', function(e) {
            const username = document.getElementById('username').value.trim();
            const content = document.getElementById('content').value.trim();
            if (!username || !content) {
                e.preventDefault();
                alert('Both username and post content are required.');
            }
        });
    </script>

</body>
</html>
